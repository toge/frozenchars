@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/frozencharsTargets.cmake")

set(frozenchars_glaze_FOUND FALSE)
if("glaze" IN_LIST frozenchars_FIND_COMPONENTS)
  find_dependency(glaze CONFIG)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/frozencharsGlazeTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/frozencharsGlazeTargets.cmake")
    if(TARGET frozenchars::glaze)
      set(frozenchars_glaze_FOUND TRUE)
    endif()
  endif()
endif()

check_required_components(frozenchars)
